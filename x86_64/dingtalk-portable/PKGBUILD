# Maintainer: Kimiblock Moe

pkgname=dingtalk-portable
pkgver=8.2.8.260818002
pkgrel=1
epoch=1
pkgdesc="DingTalk sandboxed by portable"
makedepends+=(desktop-file-utils "dingtalk-bin" "portable-packer")
arch=('x86_64')
url="www.dingtalk.com"
license=('LicenseRef-DingTalk')
conflicts=("dingtalk")
provides=("dingtalk")
source=("config.toml" "desktop.file")
sha512sums=('f96ece3f401d45a95d919e26dd957260b6738b43e1ae3170921a5a9591d1de76a85b970ea96bb803872291c22dea30dbbf2c2891b3fe21d996eca889cedf028b'
            '9d159280b7d7f90792f721486a9c7ae4a5c81abb413194979f4acdea1568cb31f35031b5bf914ac5d1794c544b7ea7b4adf87a4245a056cae77258d6e249e48a')
options=('!strip' '!debug')

package() {
  depends+=("glu" 'gtk2' 'libxcrypt-compat' libxss qt5-wayland 'portable')
  declare -x -g pkgdir
  declare -x -g pkgname
  declare -x -g srcdir
  portable-packer \
    -v \
    --distro arch \
    --mode copy dingtalk-bin \
    --config-ng "${srcdir}/config.toml" \
    --desktop-file "${srcdir}/desktop.file"

}
