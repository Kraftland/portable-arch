# Maintainer: Kimiblock Moe

pkgname=chaoxing-portable
pkgver=1.4.2
pkgrel=1
pkgdesc="超星学习通 sandboxed by portable"
arch=('any')
provides=("chaoxing")
conflicts=("chaoxing")
url="https://i.chaoxing.com"
license=("LicenseRef-custom")
options=('!strip')

source=(
	config.toml
	desktop.file
	patch.py
	patch-fingerprint.py
	unpack.py
)

makedepends+=(
	7zip
	python-cryptography
	imagemagick
	portable-packer
)

prepare() {
	download_url="$(curl \
		-fsS \
		-A 'Mozilla/5.0' \
		-X POST \
		'https://luban.m.qq.com/api/public/software-manager/softwareProxy' \
		--data-urlencode 'cmdid=3318' \
		--data-urlencode 'jprxReq={"req":{"soft_id_list":["36738"]}}' \
		| python3 -c \
		'import sys,json;print(json.load(sys.stdin)["resp"]["soft_list"][0]["download_https_url"])')"

	curl -fL -A 'Mozilla/5.0' "${download_url}" -o chaoxing.exe
}

build() {
	7z x chaoxing.exe

	approot="$(find . -maxdepth 5 -type f -name 'cxstudy.exe' -printf '%h\n' | head -n1)"

	asar="$approot/resources/app.asar"

	mkdir app

	python \
		"${srcdir}/unpack.py" \
		"${asar}" \
		"${srcdir}/app"

	python \
		"${srcdir}/patch.py" \
		"${srcdir}/app" \
		"${srcdir}/assets"

	python \
		"${srcdir}/patch-fingerprint.py" \
		"${srcdir}/app"
}

package() {
	depends+=('portable' "electron" "openssl-1.1")

	install \
		-d \
		"${pkgdir}/usr/share/chaoxing"

	cp \
		-a \
		"${srcdir}/app/." \
		"${pkgdir}/usr/share/chaoxing/app.asar"

	install -d "${pkgdir}/usr/share/icons/hicolor/256x256/apps"

	magick \
		'$PLUGINSDIR/icon.ico' \
		-resize 256x256 \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/com.chaoxing.cxstudy.png"

	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode post \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"
}
sha256sums=('6a56429217bf8052634e3bc6e275451f6e4d3af2f33960669362c9be1d392cd2'
            '4df29dc7d3f6caeae99593124f43a60b013a6408263b1a1ecd96d73f0846a9ac'
            '98b065a95c1b28fb6ad4ec0e2dfad7de574e2d7592976f9d5799f5aac18d8147'
            'bbf762821ffe1cbb5bdefd85f00f3f2fcfdb5594958b8889ef669344fc85a642'
            '92b82f2d59ec99004842bffd0c916f1e3df3fea04840fe9685903e3cbc6d2775')
