# Maintainer: Kimiblock Moe

pkgname=chaoxing-portable
pkgver=1.4.5
pkgrel=1
pkgdesc="超星学习通 sandboxed by portable"
arch=('any')
provides=("chaoxing")
conflicts=("chaoxing")
url="https://i.chaoxing.com"
license=("LicenseRef-custom")
options=('!strip')

source=(
	config.toml
	desktop.file
	patch.py
	unpack.py
)

makedepends+=(
	7zip
	python-cryptography
	imagemagick
	portable-packer
)

prepare() {
	download_url="$(curl \
		-fsS \
		-A 'Mozilla/5.0' \
		-X POST \
		'https://luban.m.qq.com/api/public/software-manager/softwareProxy' \
		--data-urlencode 'cmdid=3318' \
		--data-urlencode 'jprxReq={"req":{"soft_id_list":["36738"]}}' \
		| python3 -c \
		'import sys,json;print(json.load(sys.stdin)["resp"]["soft_list"][0]["download_https_url"])')"

	curl -fL -A 'Mozilla/5.0' "${download_url}" -o chaoxing.exe
}

build() {
	7z x -y -oext chaoxing.exe

	approot="$(find . -maxdepth 5 -type f -name 'cxstudy.exe' -printf '%h\n' | head -n1)"

	asar="$approot/resources/app.asar"

	mkdir app

	python \
		"${srcdir}/unpack.py" \
		"${asar}" \
		"${srcdir}/app"

	python \
		"${srcdir}/patch.py" \
		"${srcdir}/app"
}

package() {
	depends+=('portable' "electron" "openssl-1.1")

	install \
		-d \
		"${pkgdir}/usr/share/chaoxing"

	cp \
		-a \
		"${srcdir}/app/." \
		"${pkgdir}/usr/share/chaoxing/app.asar"

	install -d "${pkgdir}/usr/share/icons/hicolor/256x256/apps"

	for size in "512x512"; do
		install \
			-vDm644 \
			"${srcdir}/app/${size}.png" \
			"${pkgdir}/usr/share/icons/hicolor/${size}/apps/com.chaoxing.cxstudy.png"
	done



	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode post \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"
}
sha256sums=('841343a292706590347565cf669d09086fe2689692c07eb121942a52f32b2a52'
            '4c5ba78308494a87c91f0171b723196517a768c3d29ccc8ddbe3d492c6e46601'
            'ee3bc81fcba757095470b54fb90d58cf5db2c690b1f3b6595bc1ccbda5e7211e'
            '926c1b43a5e6505a9686aa3f07edff17521880e8f608457a0000e369ebd7fb62')
