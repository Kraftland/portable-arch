pkgname=shimo-portable
pkgver=3.7.6
pkgrel=1
pkgdesc="石墨文档 Shimo document. Sandboxed by Portable."
arch=('x86_64' 'aarch64')
url="https://shimo.im/"
license=('custom')
depends=('nss' 'gtk3' 'libnotify' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret')
provides=(shimo)
replaces=('shimo-bin')
source_x86_64=("https://oas.shimonote.com/panther/shimo/release/linux/x64/shimo_v${pkgver}-release.6d12f71.shimo_linux-amd64.deb")
source_aarch64=("https://oas.shimonote.com/panther/shimo/release/linux/arm64/shimo_v${pkgver}-release.6d12f71.shimo_linux-arm64.deb")
sha512sums_x86_64=('SKIP')
sha512sums_aarch64=('SKIP')

source=(
	config.toml
	shimo.desktop
)

sha256sums=(
	SKIP
	SKIP
)

package() {
	tar -xpf data.tar.gz -C "${pkgdir}"

	# License
	install -Dm644 "${pkgdir}/opt/shimo/LICENSE.electron.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
	install -Dm644 "${pkgdir}/opt/shimo/LICENSES.chromium.html" -t "${pkgdir}/usr/share/licenses/${pkgname}/"

	declare -x -g pkgdir
	declare -x -g pkgname
	declare -x -g srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode copy obsidian \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/obsidian.desktop"
}