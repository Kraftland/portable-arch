# Maintainer: Kimiblock Moe

pkgname=todaycamera-portable
pkgver=1.3.5
pkgrel=1
pkgdesc="今日水印相机 sandboxed by portable"
arch=('any')
provides=("todaycamera")
conflicts=("todaycamera")
url="https://www.5181688.com/"
license=("GPL-3.0-or-later")
options=('!strip')

source=(
	config.toml
	desktop.file

	windows.exe::"https://static.xhey.top/desktop/release/%E4%BB%8A%E6%97%A5%E6%B0%B4%E5%8D%B0%E7%9B%B8%E6%9C%BA%20Setup%201.3.5.exe"
	# extracted from https://lastest-desktop-udggzivati.cn-beijing.fcapp.run/release
)

makedepends+=(
	7zip
	imagemagick
	portable-packer
)

build() {
	7z x windows.exe

	cd '$PLUGINSDIR'

	7z x app-32.7z
}

package() {
	depends+=('portable' "electron")

	install \
		-vDm755 \
		'$PLUGINSDIR/resources/app.asar' \
		"${pkgdir}/usr/lib/todaycamera/app.asar"

	install \
		-vDm644 \
		'$PLUGINSDIR/resources/assets/app.png' \
		"${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/com.xhey.xcamera.png"

	install -d "${pkgdir}/usr/share/icons/hicolor/512x512/apps"

	magick \
		"${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/com.xhey.xcamera.png" \
		-resize 512x512 \
		"${pkgdir}/usr/share/icons/hicolor/512x512/apps/com.xhey.xcamera.png"

	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode post \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/desktop.file"
}
sha256sums=('91c09c04b720f6e6490afe82d65a61cc5c8169bc80bb3e8617f6ea3237c95b28'
            '4df29dc7d3f6caeae99593124f43a60b013a6408263b1a1ecd96d73f0846a9ac'
            '51fd44238204103d489595f72334d3b610acc7503f85a0e3d03adb46912f5e65')
